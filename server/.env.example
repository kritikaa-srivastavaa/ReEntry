DATABASE_URL=postgresql://reentry:CHANGE_ME@localhost:5432/reentry
NODE_ENV=development
# Optional manual integration runner: use a separate role with CREATEDB.
# The Windows test:isolated runner supplies its own temporary connection.
TEST_DATABASE_URL=postgresql://reentry_test:CHANGE_ME@localhost:5432/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3001
HOST=127.0.0.1
# Hosted services usually require HOST=0.0.0.0. Set proxy hops only after
# verifying the provider's proxy topology; 0 is correct for direct local access.
TRUST_PROXY_HOPS=0
# Comma-separated origins. Add your actual chrome-extension://ID after loading.
CORS_ORIGINS=http://localhost:5173
